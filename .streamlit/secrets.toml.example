# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste into
# the app's Settings → Secrets on Streamlit Community Cloud.
#
# The app tries each provider that has a key, in order, and moves to the next one
# when a model is busy (503), rate-limited (429) or down. Configure at least one.

# 1. Gemini (aistudio.google.com)
GEMINI_API_KEY = "your-gemini-key"
GEMINI_MODEL = "gemini-3.6-flash"
# GEMINI_FALLBACK_MODELS = "another-gemini-model"   # optional, comma-separated; tried when the main one is busy

# 2. Groq: hosted Llama models, free tier (console.groq.com → API Keys)
GROQ_API_KEY = "your-groq-key"
OPENAI_COMPAT_MODEL = "llama-3.1-8b-instant"   # or llama-3.3-70b-versatile for better answers
# Any other OpenAI-compatible host works too, e.g. OpenRouter:
# OPENAI_COMPAT_BASE_URL = "https://openrouter.ai/api/v1"
# OPENAI_COMPAT_API_KEY = "your-openrouter-key"

# Optional: fix the order instead of "auto" (aliases: groq, openrouter → openai)
# LLM_PROVIDER = "gemini,groq"

SUBJECT_NAME = "Brenda"
SUBJECT_FULL_NAME = "Quinsy Brenda Tebid"

# Abuse limits for the public app
MAX_QUESTIONS_PER_SESSION = "30"
MAX_QUESTION_CHARS = "500"